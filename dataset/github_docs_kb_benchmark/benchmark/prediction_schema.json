{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/github-docs-kb-prediction.schema.json",
  "title": "GitHub Docs KB retrieval prediction",
  "type": "object",
  "required": ["question_id"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "ranked_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "properties": {
              "doc_id": {"type": "string"},
              "source": {"type": "string"},
              "path": {"type": "string"},
              "uri": {"type": "string"},
              "url": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "latency_ms": {"type": "number", "minimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0},
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "total_tokens": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {"required": ["ranked_ids"]},
    {"required": ["sources"]}
  ],
  "additionalProperties": true
}
