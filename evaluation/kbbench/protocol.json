{
  "name": "docsqa-linked-docs-v5-development",
  "task": "rank canonical technical-documentation pages and answer real support questions from pinned local evidence",
  "evaluation_unit": "canonical documentation page",
  "required_top_k": 10,
  "primary_retrieval_metrics": [
    "Recall@10",
    "Hit@10",
    "nDCG@10",
    "p50_latency_ms"
  ],
  "primary_answer_metric": "CorpusConditionedGroundedWeightedAspectCoverage",
  "secondary_metrics": [
    "AllSupport@10",
    "CriticalAspectSuccess",
    "UnsupportedClaimRate",
    "CitationIntegrityRate",
    "TokensPerQA",
    "ToolCallsPerQA",
    "p95LatencyPerQA"
  ],
  "system_setting": {
    "regime": "corpus-aware zero-shot",
    "scored_questions": 467,
    "evaluation_status": "exploratory because this pool was reused during system development",
    "system_training_from_benchmark": false,
    "benchmark_examples_in_prompt": false,
    "scored_pool": "all canonical questions"
  },
  "frozen_retrieval_parameters": {
    "policy_id": "production-window-v1",
    "top_k": 10,
    "retrieval_depth": 50,
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "device": "cpu",
    "fs_max_calls": 3,
    "fs_max_matches": 250,
    "graph_seed_count": 5,
    "graph_fusion": "equal-weight RRF over the hybrid and bounded graph rankings",
    "graph_max_hops": 2,
    "max_entity_degree": 20,
    "max_route_pages": 20,
    "max_graph_candidates_per_seed": 10,
    "max_graph_candidates_total": 50,
    "neo4j_effective_search_ratio": 1
  },
  "slices": [
    "intent_category",
    "evidence_category",
    "evidence_structure",
    "qrel_count_group",
    "qrel_count_exact",
    "question_image_group",
    "question_image_text_group"
  ],
  "qrel_provenance": "distinct in-corpus documentation pages explicitly linked in accepted public support answers",
  "unjudged_policy": "zero measured gain; do not claim exhaustive irrelevance",
  "oracle_features_excluded": [
    "graph_opportunity"
  ],
  "fairness_controls": [
    "same corpus revision",
    "same question pool",
    "same top-k",
    "same language model and non-retrieval tools for agent comparisons",
    "retrieved canonical IDs logged before answer generation",
    "all failures retained in the denominator"
  ],
  "record_layout": {
    "questions": "questions.jsonl",
    "answers": "answers.jsonl",
    "join_key": "question_id",
    "partitioning": "none"
  },
  "aspect_annotations": {
    "source": "aspects.jsonl in the pinned dataset release",
    "records": 467,
    "generation_model": "gpt-5.6-luna",
    "optimization_during_evaluation": false,
    "partitioning": "none",
    "historical_provenance": "docs/RULE_OPTIMIZATION.md"
  }
}
