{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocsQA combined dataset manifest",
  "type": "object",
  "required": ["name", "documents", "questions", "qrels", "splits", "projects"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "documents": {"type": "integer", "minimum": 1},
    "questions": {"type": "integer", "minimum": 1},
    "qrels": {"type": "integer", "minimum": 1},
    "splits": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "projects": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
