{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocsQA combined dataset manifest",
  "type": "object",
  "required": [
    "name",
    "documents",
    "questions",
    "qrels",
    "projects",
    "record_layout",
    "partitioning"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "integer",
      "minimum": 1
    },
    "qrels": {
      "type": "integer",
      "minimum": 1
    },
    "projects": {
      "type": "array",
      "minItems": 1
    },
    "record_layout": {
      "const": "separate-questions-answers-v1"
    },
    "partitioning": {
      "const": "none"
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "splits"
        ]
      },
      {
        "required": [
          "split_counts"
        ]
      },
      {
        "required": [
          "questions_by_split"
        ]
      },
      {
        "required": [
          "frozen_splits"
        ]
      }
    ]
  }
}
