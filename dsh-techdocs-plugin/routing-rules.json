{
  "version": 1,
  "defaultDecision": "skip",
  "maxQueryCharacters": 1600,
  "retrievePatterns": [
    "\\b(documentation|docs?|readme|release notes?|changelog|migration|upgrade guide|design doc|proposal|specification|policy|KEP|RFC)\\b",
    "\\b(configur(?:e|ation)|settings?|feature flags?|feature gates?|deprecat(?:e|ed|ion)|backward compat(?:ibility)?|public API|contracts?|schemas?|wire format)\\b",
    "\\b(documented|expected|intended|supported)\\s+(behavior|behaviour|semantics?|lifecycle)\\b",
    "\\b(version|release)\\s+v?[0-9]+",
    "\\b(compatibility|retention|security requirement|operational requirement)\\b"
  ],
  "codeOnlyPatterns": [
    "\\b(traceback|stack trace|syntaxerror|typeerror|attributeerror|assertionerror|segmentation fault)\\b",
    "\\bfailing (unit )?tests?\\b",
    "\\b(null pointer|index out of range|off[- ]by[- ]one|race condition)\\b"
  ],
  "graphPatterns": [
    "\\b(KEP|RFC|design doc|proposal)\\b",
    "\\b(linked|links? to|references?|depends? on|related|follow[- ]up|supersedes?|replaces?)\\b",
    "\\b(across|between)\\s+(documents?|components?|subsystems?)\\b"
  ]
}
